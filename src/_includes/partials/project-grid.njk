  <div class="section-container {{ gridClass }}">
{% for item in gridItems %}
    <a href="{{ item.href }}">
      <div class="project">
        <div class="project-image {{ item.imageClass }}">
          <img src="Images/index/project.svg">
        </div>
        <div class="project-title">
          <h5>{{ item.title }}</h5>
{% if item.diff %}
          <h6 class="project-diff">{{ item.diff }}</h6>
{% endif %}
        </div>
      </div><!--project-->
    </a>
{% endfor %}
  </div>
